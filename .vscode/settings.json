{
    "files.exclude": {
        // "docs/**": true,
        "src/exp1/**": true,
        "src/exp2/**": true,
        "src/exp3/**": true,
        "src/exp4?/**": true,
        "src/exp5/**": true,
        "src/exp6/**": true,
        "src/exp7/**": true,
        "src/exp8/**": true,
        "src/exp9/**": true,
        "old/**": true,
        "src/current/usr/newlib": true,
        "src/experimental/**": true,
        "src/current/addon/usb/**": true,  // usb 
    }, 
    "search.exclude": {
        // "docs/**": true,
        "src/exp1/**": true,
        "src/exp2/**": true,
        "src/exp3/**": true,
        "src/exp4?/**": true,
        "src/exp5/**": true,
        "src/exp6/**": true,
        "src/exp7/**": true,
        "src/exp8/**": true,
        "src/exp9/**": true,
        "old/**": true,
        "src/current/usr/newlib": true,
        "src/current/addon/usb/**": true,  // usb 
        "src/experimental/**": true,        
        "*/*.asm": true,
        ".*": true,
        "*.sym": true,
        "*.dis": true,
        "*.d": true, 
    },
    "C_Cpp.exclusionPolicy": "checkFilesAndFolders",
    "editor.rulers": [
          80,  // 2nd ruler with no color option        
     ],     
     // https://stackoverflow.com/questions/42307949/color-theme-for-vs-code-integrated-terminal
     // (more colors)
     "workbench.colorCustomizations" : {
        "terminal.foreground" : "#dddad6",
        "terminal.background" : "#000000"   // 383737
    },
    // more terminal appearance https://code.visualstudio.com/docs/terminal/appearance
    "terminal.integrated.fontFamily" : "'Consolas', monospace",
    "[ARM]": {
      "editor.autoClosingBrackets": "never"
    },
    "[asm]": {
      "editor.autoClosingBrackets": "never"
    },    
    "[markdown]": {
    "editor.wordWrap": "on",
    "editor.wordWrapColumn": 80
    },
    "todo-tree.general.tags": [
        "quest",
        "!RE"
        // "xzl"
        ],
    "todo-tree.highlights.customHighlight": {
        "quest": {
            "icon": "question",
            "type": "text",
            "foreground": "red",
            "background": "yellow",
            "iconColour": "blue"
        },
        "!RE": {
            "icon": "circle-slash",
            "type": "text",
            "foreground": "red",
            "background": "yellow",
            "iconColour": "blue"
        }
    }
}
